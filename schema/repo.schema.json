{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hamad0original-lgtm/harbor-manga-repo/main/schema/repo.schema.json",
  "title": "Harbor manga plugin repository",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "plugins"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name", "entry"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "lang": { "type": "string" },
          "nsfw": { "type": "boolean" },
          "icon": { "type": "string", "pattern": "^https://" },
          "entry": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
